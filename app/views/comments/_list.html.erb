<% if comments.empty? %>
  <div class="empty-state-box py-4">
    <div class="empty-state-icon"><i class="bi bi-chat-square-text"></i></div>
    <div class="text-secondary small"><%= t("inventory.no_comments", default: "No comments yet. Start the discussion!") %></div>
  </div>
<% else %>
  <% comments.each do |comment| %>
    <div class="p-3.5 rounded-3 border bg-body-tertiary">
      <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="d-flex align-items-center gap-2">
          <span class="avatar-circle"><%= user_initials(comment.user.name) %></span>
          <%= link_to comment.user.name, user_path(comment.user), class: "fw-semibold small text-decoration-underline text-body" %>
          <% if comment.user.admin? %>
            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill" style="font-size: 0.65rem;"><%= t('admin.role_admin') %></span>
          <% end %>
        </div>
        <span class="badge bg-body text-secondary border font-mono rounded-pill" style="font-size: 0.7rem;" title="<%= comment.created_at.strftime('%Y-%m-%d %H:%M:%S') %>">
          <i class="bi bi-clock me-1"></i><%= comment.created_at.strftime("%Y-%m-%d %H:%M") %> &bull; <%= localized_time_ago(comment.created_at) %>
        </span>
      </div>
      <div class="small markdown-excerpt ps-4 ms-2 text-body">
        <%= render_markdown(comment.body) %>
      </div>
    </div>
  <% end %>
<% end %>