<section class="card hero-bento-card mb-4">
  <div class="card-body p-4 p-lg-5">
    <div class="row align-items-center g-4">
      <div class="col-lg-7">
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1.5 mb-3 fw-semibold">
          <i class="bi bi-stars me-1"></i><%= t('home.badge') %>
        </span>
        <h1 class="display-6 fw-bold mb-3" style="letter-spacing: -0.025em;"><%= t('home.hero_title') %></h1>
        <p class="text-secondary mb-4 fs-6" style="max-width: 580px;"><%= t('home.hero_subtitle') %></p>

        <div class="d-flex flex-wrap gap-2.5">
          <a href="#latest-inventories" class="btn btn-primary fw-semibold px-4 py-2 rounded-3 shadow-sm">
            <i class="bi bi-table me-2"></i><%= t('home.explore_btn') %>
          </a>
          <% if current_user %>
            <button type="button" class="btn btn-outline-primary fw-semibold px-4 py-2 rounded-3" data-bs-toggle="modal" data-bs-target="#newInventoryModal">
              <i class="bi bi-plus-lg me-1"></i><%= t('home.new_inventory_btn') %>
            </button>
          <% else %>
            <button type="button" class="btn btn-outline-primary fw-semibold px-4 py-2 rounded-3" data-bs-toggle="modal" data-bs-target="#authModal">
              <i class="bi bi-person-check me-1"></i><%= t('nav.sign_in') %>
            </button>
          <% end %>
        </div>
      </div>

      <div class="col-lg-5">
        <div class="row g-3">
          <div class="col-6">
            <div class="bento-stat-card h-100">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-secondary small fw-medium"><%= t('home.stats_inventories') %></span>
                <span class="stat-icon-badge"><i class="bi bi-folder2-open"></i></span>
              </div>
              <div class="fs-2 fw-bold font-mono text-primary"><%= @stats[:inventories_count] %></div>
            </div>
          </div>
          <div class="col-6">
            <div class="bento-stat-card h-100">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-secondary small fw-medium"><%= t('home.stats_items') %></span>
                <span class="stat-icon-badge"><i class="bi bi-box-seam"></i></span>
              </div>
              <div class="fs-2 fw-bold font-mono"><%= @stats[:items_count] %></div>
            </div>
          </div>
          <div class="col-6">
            <div class="bento-stat-card h-100">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-secondary small fw-medium"><%= t('home.tag_cloud_title') %></span>
                <span class="stat-icon-badge"><i class="bi bi-tags"></i></span>
              </div>
              <div class="fs-2 fw-bold font-mono"><%= @stats[:tags_count] %></div>
            </div>
          </div>
          <div class="col-6">
            <div class="bento-stat-card h-100">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-secondary small fw-medium"><%= t('home.col_category') %></span>
                <span class="stat-icon-badge"><i class="bi bi-grid-3x3-gap"></i></span>
              </div>
              <div class="fs-2 fw-bold font-mono"><%= all_categories.size %></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="row g-4" id="latest-inventories">
  <div class="col-xl-8">
    <div class="card overflow-hidden">
      <div class="card-header bg-transparent py-3 px-4 d-flex justify-content-between align-items-center border-bottom">
        <div class="d-flex align-items-center gap-2.5">
          <span class="stat-icon-badge" style="width: 34px; height: 34px; font-size: 0.95rem;">
            <i class="bi bi-clock-history"></i>
          </span>
          <div>
            <h2 class="h6 fw-bold mb-0"><%= t('home.latest_title') %></h2>
            <p class="text-secondary small mb-0" style="font-size: 0.76rem;"><%= t('home.latest_subtitle') %></p>
          </div>
        </div>
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill font-mono px-2.5 py-1"><%= @latest_inventories.size %></span>
      </div>

      <%= render "inventories/table", inventories: @latest_inventories, selectable: false %>
    </div>
  </div>

  <div class="col-xl-4 d-flex flex-column gap-4">
    <div class="card overflow-hidden">
      <div class="card-header bg-transparent py-3 px-4 d-flex align-items-center gap-2.5 border-bottom">
        <span class="stat-icon-badge" style="width: 34px; height: 34px; font-size: 0.95rem;">
          <i class="bi bi-trophy"></i>
        </span>
        <div>
          <h2 class="h6 fw-bold mb-0"><%= t('home.popular_title') %></h2>
          <p class="text-secondary small mb-0" style="font-size: 0.76rem;"><%= t('home.popular_subtitle') %></p>
        </div>
      </div>

      <table class="table table-hover table-enterprise table-top-popular align-middle mb-0" style="table-layout: fixed; width: 100%;">
        <thead>
          <tr>
            <th class="ps-3" style="width: 52px;"><%= t('home.col_rank') %></th>
            <th><%= t('home.col_inventory') %></th>
            <th class="text-end pe-3" style="width: 68px;"><%= t('home.col_items') %></th>
          </tr>
        </thead>
        <tbody>
          <% if @popular_inventories.empty? %>
            <tr>
              <td colspan="3" class="empty-state-box py-4">
                <div class="text-secondary small"><%= t('common.no_inventories') %></div>
              </td>
            </tr>
          <% else %>
            <% @popular_inventories.each_with_index do |inventory, idx| %>
              <tr>
                <td class="ps-3">
                  <span class="rank-badge <%= idx.zero? ? 'rank-badge-1' : 'rank-badge-2' %> font-mono">
                    #<%= idx + 1 %>
                  </span>
                </td>
                <td class="overflow-hidden">
                  <div class="d-flex align-items-center gap-2.5" style="min-width: 0;">
                    <% if inventory.image_url.present? %>
                      <img src="<%= inventory.image_url %>"
                           alt=""
                           class="rounded-2 border object-fit-cover flex-shrink-0"
                           style="width: 36px; height: 36px;"
                           onerror="this.classList.add('d-none'); this.nextElementSibling.classList.remove('d-none');">
                      <div class="inventory-icon-box d-none flex-shrink-0" style="width: 36px; height: 36px;">
                        <i class="bi <%= category_icon_class(inventory.category.name) %>"></i>
                      </div>
                    <% else %>
                      <div class="inventory-icon-box flex-shrink-0" style="width: 36px; height: 36px;">
                        <i class="bi <%= category_icon_class(inventory.category.name) %>"></i>
                      </div>
                    <% end %>
                    <div class="flex-grow-1 overflow-hidden" style="min-width: 0;">
                      <%= link_to inventory.title,
                            inventory_path(inventory),
                            title: inventory.title,
                            class: "fw-semibold text-decoration-underline d-block small text-body text-truncate" %>
                      <span class="text-secondary d-block text-truncate" style="font-size: 0.74rem;">
                        <%= link_to inventory.creator.name, user_path(inventory.creator), class: "text-secondary text-decoration-none" %>
                      </span>
                    </div>
                  </div>
                </td>
                <td class="text-end pe-3">
                  <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill font-mono px-2.5"><%= inventory.items_count %></span>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="card">
      <div class="card-header bg-transparent py-3 px-4 d-flex align-items-center gap-2.5 border-bottom">
        <span class="stat-icon-badge" style="width: 34px; height: 34px; font-size: 0.95rem;">
          <i class="bi bi-hash"></i>
        </span>
        <div>
          <h2 class="h6 fw-bold mb-0"><%= t('home.tag_cloud_title') %></h2>
          <p class="text-secondary small mb-0" style="font-size: 0.76rem;"><%= t('home.tag_cloud_subtitle') %></p>
        </div>
      </div>

      <div class="card-body p-3.5 d-flex flex-wrap gap-2 align-items-center">
        <% if @tags.empty? %>
          <span class="text-secondary small"><%= t('common.no_inventories') %></span>
        <% else %>
          <% @tags.each do |tag| %>
            <%= link_to search_path(tag: tag.name),
                  class: "tag-pill-cloud #{tag_cloud_weight_class(tag, @max_tag_count)}" do %>
              <span class="text-primary">#</span><%= tag.name %> <span class="opacity-75 font-mono ms-0.5">(<%= tag.inventories_count %>)</span>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>