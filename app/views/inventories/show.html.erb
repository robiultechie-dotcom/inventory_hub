<%
  can_manage = @inventory.manageable_by?(current_user)
  can_write  = @inventory.writable_by?(current_user)
  primary_link_field = @dynamic_table_fields.find { |f| f.field_type == "string" } || @dynamic_table_fields.first
  id_link_decoration = primary_link_field.nil? ? "text-decoration-underline" : "text-decoration-none"

  tabs = [
    [ "items",      "bi-table",                    t('inventory.tabs.items'),      @inventory.items_count, nil,              true ],
    [ "discussion", "bi-chat-dots",                t('inventory.tabs.discussion'), @comments.size,         "chatTabCount",   true ],
    [ "settings",   "bi-sliders",                  t('inventory.tabs.settings'),   nil,                    nil,              can_manage ],
    [ "custom_id",  "bi-upc-scan",                 t('inventory.tabs.custom_id'),  nil,                    nil,              can_manage ],
    [ "fields",     "bi-input-cursor-text",        t('inventory.tabs.fields'),     @custom_fields.size,    "fieldsTabCount", can_manage ],
    [ "access",     "bi-shield-check",             t('inventory.tabs.access'),     nil,                    nil,              can_manage ],
    [ "stats",      "bi-bar-chart-line",           t('inventory.tabs.stats'),      nil,                    nil,              can_manage ],
    [ "export",     "bi-file-earmark-spreadsheet", t('inventory.tabs.export'),     nil,                    nil,              can_manage ]
  ]
%>

<div data-controller="inventory-workspace">
  <div data-inventory-workspace-target="conflictBanner" class="alert alert-danger d-none shadow-sm rounded-3 border-0 mb-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div class="d-flex align-items-center">
      <i class="bi bi-exclamation-octagon-fill fs-5 me-2"></i>
      <strong data-inventory-workspace-target="conflictMessage"><%= t('inventory.conflict_msg') %></strong>
    </div>
    <div class="d-flex gap-2">
      <button type="button" data-action="click->inventory-workspace#reloadWorkspace" class="btn btn-sm btn-outline-danger bg-body fw-semibold rounded-3">
        <i class="bi bi-arrow-clockwise me-1"></i><%= t('inventory.reload_latest') %>
      </button>
      <button type="button" data-action="click->inventory-workspace#forceOverwrite" class="btn btn-sm btn-danger fw-semibold rounded-3">
        <i class="bi bi-cloud-upload me-1"></i><%= t('inventory.overwrite_retry') %>
      </button>
    </div>
  </div>

  <div class="card hero-bento-card mb-4">
    <div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
      <div class="d-flex align-items-start gap-3">
        <img data-inventory-workspace-target="headerImage"
             src="<%= @inventory.image_url %>"
             alt=""
             class="rounded-3 border object-fit-cover shadow-sm flex-shrink-0 <%= 'd-none' if @inventory.image_url.blank? %>"
             style="width: 72px; height: 72px;"
             onerror="this.classList.add('d-none'); this.nextElementSibling.classList.remove('d-none');">

        <div data-inventory-workspace-target="headerIcon"
             class="inventory-icon-box flex-shrink-0 <%= 'd-none' if @inventory.image_url.present? %>"
             style="width: 72px; height: 72px;">
          <i class="bi <%= category_icon_class(@inventory.category.name) %> fs-3"></i>
        </div>

        <div>
          <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
            <h1 data-inventory-workspace-target="headerTitle" class="h4 fw-bold mb-0" style="letter-spacing: -0.02em;"><%= @inventory.title %></h1>
            <% if can_manage %>
              <span id="autoSaveBadge" class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                <i class="bi bi-cloud-check-fill me-1"></i><%= t('common.saved_badge') %>
              </span>
            <% end %>
          </div>

          <div class="d-flex flex-wrap align-items-center gap-2 text-secondary small mb-2">
            <span data-inventory-workspace-target="headerCategory" class="badge bg-body-secondary text-body border rounded-pill px-3 py-1">
              <i class="bi <%= category_icon_class(@inventory.category.name) %> me-1 text-primary"></i><%= localized_category_name(@inventory.category) %>
            </span>
            <span>&bull;</span>
            <span><%= t('inventory.created_by') %> <%= link_to @inventory.creator.name, user_path(@inventory.creator), class: "fw-semibold text-body text-decoration-underline" %></span>
            <% if can_manage %>
              <span>&bull;</span>
              <span class="badge bg-body-tertiary text-secondary border font-mono px-2 py-1"
                    data-bs-toggle="tooltip"
                    title="<%= t('common.revision', version: @inventory.lock_version, default: "Revision #{@inventory.lock_version}") %>">
                <i class="bi bi-layers me-1"></i>v<span id="headerLockVersion"><%= @inventory.lock_version %></span>
              </span>
            <% end %>
            <span data-inventory-workspace-target="headerVisibility" class="badge rounded-pill px-3 py-1 <%= @inventory.is_public? ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-secondary-subtle text-secondary border border-secondary-subtle' %>">
              <i class="bi <%= @inventory.is_public? ? 'bi-globe2' : 'bi-lock-fill' %> me-1"></i><%= @inventory.is_public? ? t('common.public') : t('common.restricted') %>
            </span>
          </div>

          <div data-inventory-workspace-target="headerDescription" class="text-secondary small markdown-excerpt"><%= render_markdown(@inventory.description) %></div>

          <div data-inventory-workspace-target="headerTags" class="d-flex flex-wrap gap-2 mt-2 <%= 'd-none' if @inventory.tags.empty? %>">
            <% @inventory.tags.each do |tag| %>
              <%= link_to search_path(tag: tag.name), class: "tag-pill-cloud tag-weight-1" do %>
                <span class="text-primary">#</span><%= tag.name %>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>

      <% if can_write %>
        <%= link_to new_inventory_item_path(@inventory), class: "btn btn-primary btn-sm fw-semibold px-3 py-2 rounded-3 shadow-sm" do %>
          <i class="bi bi-plus-lg me-1"></i><%= t('inventory.add_item') %>
        <% end %>
      <% end %>
    </div>
  </div>

  <ul class="nav nav-tabs nav-tabs-modern mb-4 flex-nowrap">
    <% tabs.each do |key, icon, label, count_val, count_id, visible| %>
      <% next unless visible %>
      <li class="nav-item">
        <%= link_to inventory_path(@inventory, tab: key),
              data: (can_manage ? { action: "click->inventory-workspace#flushBeforeTabChange" } : {}),
              class: "nav-link text-nowrap #{'active' if @active_tab == key}" do %>
          <i class="bi <%= icon %>"></i>
          <span>
            <%= label %><% unless count_val.nil? %> (<%= content_tag(:span, count_val, id: count_id) %>)<% end %>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>

  <% if @active_tab == "items" %>
    <%
      pagination_params = { tab: "items" }
      pagination_params[:item_q]    = @item_query if @item_query.present?
      pagination_params[:item_sort] = @item_sort  if @item_sort != "newest"
    %>
    <div class="card overflow-hidden" data-controller="table-selection">
      <div data-table-selection-target="toolbar" class="context-toolbar d-flex flex-wrap align-items-center justify-content-between gap-2">
        <% if current_user %>
          <%= form_with url: bulk_destroy_inventory_items_path(@inventory), method: :delete, data: { table_selection_target: "form" }, class: "d-none" do %>
            <div data-table-selection-target="idsContainer"></div>
          <% end %>

          <div class="d-flex flex-wrap align-items-center gap-2">
            <span data-table-selection-target="counter" data-label="<%= t('home.toolbar_selected') %>" class="badge text-bg-secondary rounded-pill font-mono px-3 py-1">
              0 <%= t('home.toolbar_selected') %>
            </span>
            <button type="button" data-table-selection-target="singleAction" data-action="click->table-selection#openSelected" class="btn btn-sm btn-outline-primary rounded-3" disabled>
              <i class="bi <%= can_write ? 'bi-pencil-square' : 'bi-box-arrow-up-right' %> me-1"></i><%= can_write ? t('common.edit') : t('common.open') %>
            </button>
            <button type="button" data-table-selection-target="bulkAction" data-action="click->table-selection#likeSelected" class="btn btn-sm btn-outline-danger rounded-3" disabled>
              <i class="bi bi-heart me-1"></i><%= t('common.like_toggle') %>
            </button>
            <% if can_write %>
              <button type="button" data-table-selection-target="bulkAction" data-action="click->table-selection#submitBulk" data-confirm-message="<%= t('items.confirm_delete') %>" class="btn btn-sm btn-outline-danger rounded-3" disabled>
                <i class="bi bi-trash3 me-1"></i><%= t('common.delete') %>
              </button>
            <% end %>
          </div>
        <% else %>
          <span class="badge bg-body-secondary text-secondary border rounded-pill px-3 py-1">
            <i class="bi bi-eye me-1"></i><%= t('common.read_only') %>
          </span>
        <% end %>

        <%= form_with url: inventory_path(@inventory), method: :get, local: true, class: "d-flex flex-wrap align-items-center gap-2 ms-auto" do %>
          <%= hidden_field_tag :tab, "items" %>

          <div class="input-group input-group-sm" style="width: 260px;">
            <span class="input-group-text bg-body border-end-0 text-secondary"><i class="bi bi-funnel"></i></span>
            <input type="search"
                   name="item_q"
                   value="<%= @item_query %>"
                   data-action="search->inventory-workspace#submitItemFilter"
                   class="form-control border-start-0 ps-0"
                   placeholder="<%= t('inventory.item_filter_placeholder', default: 'Filter items by ID or values...') %>">
            <% if @item_query.present? %>
              <%= link_to inventory_path(@inventory, tab: "items", item_sort: (@item_sort unless @item_sort == "newest")),
                    class: "btn btn-outline-secondary border-start-0",
                    title: t('common.cancel'),
                    aria: { label: t('common.cancel') } do %>
                <i class="bi bi-x-lg"></i>
              <% end %>
            <% end %>
          </div>

          <select name="item_sort"
                  data-action="change->inventory-workspace#submitItemFilter"
                  class="form-select form-select-sm"
                  style="width: 155px;">
            <option value="newest" <%= "selected" if @item_sort == "newest" %>><%= t('workspace.sort_newest') %></option>
            <option value="oldest" <%= "selected" if @item_sort == "oldest" %>><%= t('workspace.sort_oldest') %></option>
            <option value="id_asc" <%= "selected" if @item_sort == "id_asc" %>>ID (A-Z)</option>
            <option value="id_desc" <%= "selected" if @item_sort == "id_desc" %>>ID (Z-A)</option>
            <option value="likes_desc" <%= "selected" if @item_sort == "likes_desc" %>><%= t('common.likes') %></option>
          </select>

          <button type="submit" class="btn btn-sm btn-outline-primary rounded-3 px-2.5" aria-label="<%= t('common.search_heading') %>">
            <i class="bi bi-funnel-fill"></i>
          </button>
        <% end %>
      </div>

      <div class="table-responsive">
        <table class="table table-hover table-enterprise align-middle mb-0">
          <thead>
            <tr>
              <% if current_user %>
                <th class="ps-4" style="width: 44px;">
                  <input type="checkbox" class="form-check-input" data-table-selection-target="selectAll" data-action="change->table-selection#toggleAll">
                </th>
              <% end %>
              <th class="<%= 'ps-4' unless current_user %>">ID</th>
              <% @dynamic_table_fields.each do |field| %><th><%= field.name %></th><% end %>
              <th><%= t('home.col_creator') %></th>
              <th class="text-end pe-4"><%= t('common.likes') %></th>
            </tr>
          </thead>
          <tbody>
            <% if @items.empty? %>
              <tr>
                <td colspan="<%= @dynamic_table_fields.size + (current_user ? 4 : 3) %>" class="empty-state-box">
                  <div class="empty-state-icon"><i class="bi bi-inbox"></i></div>
                  <div class="fw-semibold text-body mb-1"><%= t('common.no_items') %></div>
                  <% if @item_query.present? %>
                    <div class="mt-2">
                      <%= link_to inventory_path(@inventory, tab: "items", item_sort: (@item_sort unless @item_sort == "newest")),
                            class: "btn btn-sm btn-outline-secondary rounded-3 px-3" do %>
                        <i class="bi bi-arrow-counterclockwise me-1"></i><%= t('common.back') %>
                      <% end %>
                    </div>
                  <% elsif can_write %>
                    <div class="mt-2">
                      <%= link_to new_inventory_item_path(@inventory), class: "btn btn-sm btn-primary rounded-3 px-3" do %>
                        <i class="bi bi-plus-lg me-1"></i><%= t('inventory.add_item') %>
                      <% end %>
                    </div>
                  <% end %>
                </td>
              </tr>
            <% else %>
              <% @items.each do |item| %>
                <% target_url = can_write ? edit_inventory_item_path(@inventory, item) : inventory_item_path(@inventory, item) %>
                <% like_url   = toggle_like_inventory_item_path(@inventory, item) %>
                <% liked      = @liked_item_ids.include?(item.id) %>
                <tr data-url="<%= target_url %>"
                    data-like-url="<%= like_url %>"
                    data-likes="<%= item.likes_count %>">
                  <% if current_user %>
                    <td class="ps-4">
                      <input type="checkbox" class="form-check-input" value="<%= item.id %>" data-table-selection-target="rowCheckbox" data-action="change->table-selection#toggleRow">
                    </td>
                  <% end %>
                  <td class="font-mono fw-semibold <%= 'ps-4' unless current_user %>">
                    <%= link_to item.custom_id, target_url, class: "badge bg-primary-subtle text-primary border border-primary-subtle #{id_link_decoration} font-mono px-3 py-1" %>
                  </td>
                  <% @dynamic_table_fields.each do |field| %>
                    <% val = item.value_for(field) %>
                    <td>
                      <% if field.boolean? %>
                        <input type="checkbox" class="form-check-input" <%= "checked" if val %> disabled>
                      <% elsif field.link? && val.present? %>
                        <div class="d-flex align-items-center gap-2">
                          <% if val.to_s.match?(/\.(jpg|jpeg|png|gif|webp)(\?.*)?$/i) || val.to_s.include?("images.unsplash.com") || val.to_s.include?("res.cloudinary.com") || val.to_s.include?("iili.io") %>
                            <img src="<%= val %>" alt="" class="rounded-2 border object-fit-cover" style="width: 30px; height: 30px;" onerror="this.classList.add('d-none');">
                          <% else %>
                            <i class="bi bi-file-earmark-richtext text-primary"></i>
                          <% end %>
                          <%= link_to truncate(val.to_s.split("/").last.presence || val.to_s, length: 24), val.to_s, target: "_blank", rel: "noopener noreferrer", class: "small text-decoration-underline fw-medium" %>
                        </div>
                      <% elsif field.select_list? %>
                        <% if val.present? %>
                          <% if field == primary_link_field %>
                            <%= link_to val, target_url, class: "badge bg-body-secondary text-body border rounded-pill px-2.5 py-1 text-decoration-underline fw-medium" %>
                          <% else %>
                            <span class="badge bg-body-secondary text-body border rounded-pill px-2.5 py-1 fw-medium"><%= val %></span>
                          <% end %>
                        <% else %>
                          <span class="text-secondary">—</span>
                        <% end %>
                      <% elsif field == primary_link_field %>
                        <%= link_to (field.numeric? ? format_numeric_value(val) : (val.presence || "—")), target_url, class: "text-body text-decoration-underline fw-semibold" %>
                      <% elsif field.numeric? %>
                        <span class="font-mono"><%= format_numeric_value(val) %></span>
                      <% elsif field.field_type == "text" %>
                        <span class="small"><%= val.present? ? truncate(val.to_s, length: 65) : "—" %></span>
                      <% else %>
                        <span><%= val.presence || "—" %></span>
                      <% end %>
                    </td>
                  <% end %>
                  <td>
                    <div class="d-flex align-items-center gap-2">
                      <span class="avatar-circle" style="width: 26px; height: 26px; font-size: 0.68rem;"><%= user_initials(item.created_by.name) %></span>
                      <div>
                        <%= link_to item.created_by.name, user_path(item.created_by), class: "text-decoration-none text-body fw-medium small d-block" %>
                        <span class="text-secondary font-mono d-block" style="font-size: 0.7rem;"><%= localized_time_ago(item.created_at) %></span>
                      </div>
                    </div>
                  </td>
                  <td class="text-end pe-4">
                    <span data-like-badge class="badge rounded-pill font-mono px-2.5 py-1 <%= liked ? 'bg-danger-subtle text-danger border border-danger-subtle' : 'bg-body-tertiary text-secondary border' %>">
                      <i data-like-icon class="bi <%= liked ? 'bi-heart-fill' : 'bi-heart' %> me-1"></i>
                      <span data-like-count><%= item.likes_count %></span>
                    </span>
                  </td>
                </tr>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @total_pages.to_i > 1 %>
        <div class="card-footer bg-transparent py-2.5 px-4 d-flex justify-content-between align-items-center border-top">
          <span class="text-secondary small font-mono">
            <%= t('common.page_summary', page: @page, total: @total_pages) %>
          </span>
          <div class="btn-group btn-group-sm">
            <%= link_to t('common.prev_page'),
                  inventory_path(@inventory, pagination_params.merge(page: [ @page - 1, 1 ].max)),
                  class: "btn btn-outline-secondary #{'disabled' if @page <= 1}" %>
            <%= link_to t('common.next_page'),
                  inventory_path(@inventory, pagination_params.merge(page: [ @page + 1, @total_pages ].min)),
                  class: "btn btn-outline-secondary #{'disabled' if @page >= @total_pages}" %>
          </div>
        </div>
      <% end %>
    </div>

  <% elsif @active_tab == "discussion" %>
    <div class="card p-4">
      <div class="d-flex align-items-center justify-content-between pb-3 mb-3 border-bottom">
        <div class="d-flex align-items-center gap-2">
          <span class="stat-icon-badge" style="width: 34px; height: 34px;"><i class="bi bi-chat-dots"></i></span>
          <h2 class="h6 fw-bold mb-0"><%= t('inventory.tabs.discussion') %></h2>
        </div>
        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill font-mono px-3 py-1">
          <i class="bi bi-broadcast me-1"></i><%= t('inventory.live_stream') %>
        </span>
      </div>

      <div data-inventory-workspace-target="discussionList"
           data-poll-url="<%= inventory_comments_path(@inventory) %>"
           class="d-flex flex-column gap-3 mb-4">
        <%= render "comments/list", comments: @comments %>
      </div>

      <% if current_user %>
        <%= form_with model: [ @inventory, Comment.new ],
              data: { inventory_workspace_target: "commentForm", action: "submit->inventory-workspace#submitComment" },
              class: "p-3 rounded-3 border bg-body-tertiary" do |f| %>
          <div class="mb-2">
            <%= f.text_area :body,
                  rows: 3,
                  class: "form-control modern-input bg-body",
                  placeholder: t('inventory.chat_placeholder'),
                  data: { inventory_workspace_target: "commentInput" },
                  required: true %>
          </div>
          <div class="d-flex justify-content-between align-items-center">
            <span class="text-secondary small"><i class="bi bi-markdown me-1"></i>Markdown</span>
            <%= f.submit t('inventory.post_comment'),
                  data: { inventory_workspace_target: "commentSubmit" },
                  class: "btn btn-primary btn-sm fw-semibold rounded-3 px-4 shadow-sm" %>
          </div>
        <% end %>
      <% end %>
    </div>

  <% elsif @active_tab == "settings" && can_manage %>
    <div class="card p-4">
      <%= form_with model: @inventory, url: inventory_path(@inventory, tab: "settings"), method: :patch, data: { inventory_workspace_target: "autoSaveForm" } do |f| %>
        <%= f.hidden_field :lock_version, data: { inventory_workspace_target: "lockVersion" } %>
        <%= f.hidden_field :image_url, data: { inventory_workspace_target: "imageUrlInput" } %>
        <input type="hidden" name="force_overwrite" value="0" data-inventory-workspace-target="forceOverwriteInput">

        <div class="row g-4">
          <div class="col-lg-7">
            <div class="mb-3">
              <%= f.label :title, t('inventory.title'), class: "form-label modern-label" %>
              <%= f.text_field :title, class: "form-control modern-input", required: true %>
            </div>
            <div class="row g-3 mb-3">
              <div class="col-sm-5">
                <%= f.label :category_id, t('home.col_category'), class: "form-label modern-label" %>
                <%= f.select :category_id,
                      options_for_select(all_categories.map { |c| [ localized_category_name(c), c.id ] }, @inventory.category_id),
                      {},
                      class: "form-select modern-input" %>
              </div>
              <div class="col-sm-7">
                <%= f.label :tag_list, t('inventory.tags'), class: "form-label modern-label" %>
                <%= f.text_field :tag_list, value: @inventory.tag_list, class: "form-control modern-input", data: { inventory_workspace_target: "tagInput" } %>
              </div>
            </div>
            <div class="mb-3">
              <%= f.label :description, t('inventory.description'), class: "form-label modern-label" %>
              <%= f.text_area :description, rows: 4, class: "form-control modern-input", data: { inventory_workspace_target: "markdownInput" } %>
            </div>
            <div class="p-3 rounded-3 border bg-body-tertiary d-flex align-items-center justify-content-between gap-3">
              <div>
                <label class="fw-semibold small d-block mb-0" for="settingsPublicSwitch"><%= t('common.public') %></label>
                <span class="text-secondary" style="font-size: 0.76rem;"><%= t('inventory.public_access') %></span>
              </div>
              <div class="form-check form-switch m-0">
                <%= f.check_box :is_public, class: "form-check-input fs-5", id: "settingsPublicSwitch" %>
              </div>
            </div>
          </div>

          <div class="col-lg-5">
            <label class="form-label modern-label"><%= t('inventory.cloud_image') %></label>
            <div data-inventory-workspace-target="dropzone" class="cloud-dropzone mb-3"></div>

            <div data-inventory-workspace-target="imagePreviewCard"
                 class="p-3 rounded-3 border bg-body-tertiary d-flex align-items-center justify-content-between gap-3 <%= 'd-none' if @inventory.image_url.blank? %>">
              <div class="d-flex align-items-center gap-3 overflow-hidden">
                <img data-inventory-workspace-target="imagePreviewImg"
                     src="<%= @inventory.image_url %>"
                     alt=""
                     class="rounded-3 border object-fit-cover flex-shrink-0"
                     style="width: 60px; height: 60px;">
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                  <i class="bi bi-image-fill me-1"></i><%= t('inventory.image_uploaded', default: 'Cover image uploaded') %>
                </span>
              </div>
              <button type="button" data-inventory-workspace-target="removeImgBtn" class="btn btn-sm btn-outline-danger rounded-3 flex-shrink-0">
                <i class="bi bi-trash3 me-1"></i><%= t('common.delete') %>
              </button>
            </div>
          </div>

          <div class="col-12 pt-3 border-top d-flex justify-content-end">
            <%= f.submit t('common.save'), class: "btn btn-primary btn-sm fw-semibold rounded-3 px-4 py-2 shadow-sm" %>
          </div>
        </div>
      <% end %>
    </div>

  <% elsif @active_tab == "custom_id" && can_manage %>
    <div class="card p-4">
      <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-3 border-bottom gap-2">
        <div class="px-3 py-2 rounded-3 bg-body-tertiary border d-flex align-items-center gap-2">
          <span class="text-secondary small"><%= t('inventory.custom_id_example') %></span>
          <strong data-inventory-workspace-target="idPreview" class="font-mono fs-5 text-primary"><%= @id_generator.generate(preview: true) %></strong>
        </div>
      </div>

      <%= form_with url: update_custom_id_inventory_path(@inventory), method: :patch, data: { inventory_workspace_target: "autoSaveForm" } do %>
        <%= hidden_field_tag :lock_version, @inventory.lock_version, data: { inventory_workspace_target: "lockVersion" } %>
        <%= hidden_field_tag :clear_all, (@inventory.custom_id_config.empty? ? "1" : "0"), data: { inventory_workspace_target: "clearAllInput" } %>
        <input type="hidden" name="force_overwrite" value="0" data-inventory-workspace-target="forceOverwriteInput">

        <div data-inventory-workspace-target="idList"
             data-next-seq="<%= @id_generator.next_sequence_number %>"
             data-action="input->inventory-workspace#computeIdPreview"
             class="d-flex flex-column gap-2 p-3 rounded-3 border bg-body-tertiary mb-3">
          <div data-inventory-workspace-target="idEmptyState" class="text-center text-secondary small py-3 <%= 'd-none' if @inventory.custom_id_config.any? %>">
            <i class="bi bi-upc-scan d-block fs-4 mb-1 opacity-75"></i>
            <%= t('inventory.custom_id_example') %> <span class="font-mono fw-semibold">ITEM-0001</span>
          </div>

          <% @inventory.custom_id_config.each do |el| %>
            <% spec_val = el["format"].presence || el["value"].to_s %>
            <% is_guid = el["type"] == "guid" %>
            <div class="id-element-row p-2 rounded-3 bg-body border shadow-sm">
              <div class="row g-2 align-items-center">
                <div class="col-md-3 d-flex align-items-center gap-2">
                  <span class="drag-handle text-secondary px-1" style="cursor: grab;"><i class="bi bi-grip-vertical"></i></span>
                  <select name="elements[][type]" class="form-select form-select-sm id-part-type" data-action="change->inventory-workspace#onElementTypeChange">
                    <% CustomIdGenerator::SUPPORTED_ELEMENTS.each do |key, label| %>
                      <option value="<%= key %>" <%= "selected" if el["type"] == key %>><%= localized_id_element_label(key, label) %></option>
                    <% end %>
                  </select>
                </div>
                <div class="col-md-3">
                  <input type="text" name="elements[][spec]" value="<%= spec_val %>" class="form-control form-control-sm font-mono id-part-spec <%= 'bg-body-secondary text-secondary' if is_guid %>" placeholder="📦-, X5_, D3_, yyyy" <%= "readonly" if is_guid %>>
                </div>
                <div class="col-md-6 d-flex align-items-center justify-content-between gap-2">
                  <span class="text-secondary small id-part-hint"></span>
                  <div class="d-flex align-items-center gap-1.5 flex-shrink-0">
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-circle"
                            data-bs-toggle="popover" data-bs-trigger="focus"
                            data-bs-title="<%= t('inventory.popover_title') %>"
                            data-bs-content="<%= t('inventory.popover_body') %>">
                      <i class="bi bi-question-lg"></i>
                    </button>
                    <button type="button" data-action="click->inventory-workspace#removeIdElement" class="btn btn-sm btn-outline-danger rounded-3" title="<%= t('common.delete') %>">
                      <i class="bi bi-x-lg"></i>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>

        <template id="idElementRowTemplate">
          <div class="id-element-row p-2 rounded-3 bg-body border shadow-sm">
            <div class="row g-2 align-items-center">
              <div class="col-md-3 d-flex align-items-center gap-2">
                <span class="drag-handle text-secondary px-1" style="cursor: grab;"><i class="bi bi-grip-vertical"></i></span>
                <select name="elements[][type]" class="form-select form-select-sm id-part-type" data-action="change->inventory-workspace#onElementTypeChange">
                  <% CustomIdGenerator::SUPPORTED_ELEMENTS.each do |key, label| %>
                    <option value="<%= key %>"><%= localized_id_element_label(key, label) %></option>
                  <% end %>
                </select>
              </div>
              <div class="col-md-3">
                <input type="text" name="elements[][spec]" value="📦-" class="form-control form-control-sm font-mono id-part-spec" placeholder="📦-, X5_, D3_, yyyy">
              </div>
              <div class="col-md-6 d-flex align-items-center justify-content-between gap-2">
                <span class="text-secondary small id-part-hint"></span>
                <div class="d-flex align-items-center gap-1.5 flex-shrink-0">
                  <button type="button" class="btn btn-sm btn-outline-secondary rounded-circle"
                          data-bs-toggle="popover" data-bs-trigger="focus"
                          data-bs-title="<%= t('inventory.popover_title') %>"
                          data-bs-content="<%= t('inventory.popover_body') %>">
                    <i class="bi bi-question-lg"></i>
                  </button>
                  <button type="button" data-action="click->inventory-workspace#removeIdElement" class="btn btn-sm btn-outline-danger rounded-3" title="<%= t('common.delete') %>">
                    <i class="bi bi-x-lg"></i>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </template>

        <p class="text-secondary small mb-3"><i class="bi bi-info-circle me-1"></i><%= t('inventory.custom_id_help_text') %></p>

        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
          <button type="button" data-action="click->inventory-workspace#addIdElement" class="btn btn-outline-primary btn-sm fw-semibold rounded-3 px-3">
            <i class="bi bi-plus-lg me-1"></i><%= t('inventory.add_element') %>
          </button>
          <button type="submit" class="btn btn-primary btn-sm fw-semibold rounded-3 px-4 py-2 shadow-sm"><%= t('common.save') %></button>
        </div>
      <% end %>
    </div>

  <% elsif @active_tab == "fields" && can_manage %>
    <div class="card p-4">
      <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-3 border-bottom gap-2">
        <div>
          <h2 class="h6 fw-bold mb-1"><%= t('inventory.fields_title_unlimited') %></h2>
          <p class="text-secondary small mb-0"><%= t('inventory.fields_subtitle') %></p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
          <select data-inventory-workspace-target="fieldTypeSelect" class="form-select form-select-sm" style="width: 235px;">
            <option value="string"><%= localized_field_type_label('string') %></option>
            <option value="text"><%= localized_field_type_label('text') %></option>
            <option value="int"><%= localized_field_type_label('int') %></option>
            <option value="link"><%= localized_field_type_label('link') %></option>
            <option value="bool"><%= localized_field_type_label('bool') %></option>
            <option value="select"><%= localized_field_type_label('select') %></option>
          </select>
          <button type="button" data-action="click->inventory-workspace#addDynamicField" class="btn btn-sm btn-outline-primary fw-semibold rounded-3 px-3">
            <i class="bi bi-plus-lg me-1"></i><%= t('inventory.add_field') %>
          </button>
        </div>
      </div>

      <%= form_with url: update_fields_inventory_path(@inventory), method: :patch, data: { inventory_workspace_target: "autoSaveForm" } do %>
        <%= hidden_field_tag :lock_version, @inventory.lock_version, data: { inventory_workspace_target: "lockVersion" } %>
        <%= hidden_field_tag :custom_fields_submitted, "1" %>
        <input type="hidden" name="force_overwrite" value="0" data-inventory-workspace-target="forceOverwriteInput">

        <div data-inventory-workspace-target="fieldsList" class="d-flex flex-column gap-2.5 mb-3">
          <div data-inventory-workspace-target="fieldsEmptyState" class="text-center text-secondary small py-4 rounded-3 border bg-body-tertiary <%= 'd-none' if @custom_fields.any? %>">
            <i class="bi bi-input-cursor-text d-block fs-4 mb-1 opacity-75"></i>
            <%= t('inventory.no_fields_yet') %>
          </div>

          <% @custom_fields.each_with_index do |field, idx| %>
            <% is_text = field.text_based? %>
            <% is_num  = field.numeric? %>
            <% is_sel  = field.select_list? %>
            <div class="dynamic-field-row p-3 rounded-3 bg-body border shadow-sm">
              <input type="hidden" name="custom_fields[<%= idx %>][id]" value="<%= field.id %>" class="field-id-input">
              <input type="hidden" name="custom_fields[<%= idx %>][position]" value="<%= idx + 1 %>" class="field-position-input">

              <div class="row g-2 align-items-center">
                <div class="col-12 col-lg-3 d-flex align-items-center gap-2">
                  <span class="field-drag-handle text-secondary px-1 flex-shrink-0" style="cursor: grab;"><i class="bi bi-grip-vertical"></i></span>
                  <select name="custom_fields[<%= idx %>][field_type]"
                          class="form-select form-select-sm field-type-select"
                          data-action="change->inventory-workspace#onDynamicFieldTypeChange">
                    <% CustomField::FIELD_TYPES.each do |type_key, fallback| %>
                      <option value="<%= type_key %>" <%= "selected" if field.field_type == type_key %>><%= localized_field_type_label(type_key, fallback) %></option>
                    <% end %>
                  </select>
                </div>
                <div class="col-12 col-md-5 col-lg-3">
                  <input type="text"
                         name="custom_fields[<%= idx %>][name]"
                         value="<%= field.name %>"
                         class="form-control form-control-sm fw-semibold field-name-input"
                         placeholder="<%= t('inventory.field_title_placeholder') %>"
                         required>
                </div>
                <div class="col-12 col-md-7 col-lg-3">
                  <input type="text"
                         name="custom_fields[<%= idx %>][description]"
                         value="<%= field.description %>"
                         class="form-control form-control-sm"
                         placeholder="<%= t('inventory.field_desc_placeholder') %>">
                </div>
                <div class="col-12 col-lg-3 d-flex align-items-center justify-content-between justify-content-lg-end gap-2">
                  <div class="form-check m-0">
                    <input type="hidden" name="custom_fields[<%= idx %>][show_in_table]" value="0">
                    <input type="checkbox"
                           name="custom_fields[<%= idx %>][show_in_table]"
                           value="1"
                           class="form-check-input field-show-checkbox"
                           id="tbl_cf_<%= idx %>"
                           <%= "checked" if field.show_in_table? %>>
                    <label class="form-check-label small text-nowrap field-show-label" for="tbl_cf_<%= idx %>"><%= t('inventory.show_in_table') %></label>
                  </div>
                  <button type="button"
                          data-action="click->inventory-workspace#removeDynamicField"
                          class="btn btn-sm btn-outline-danger rounded-3 flex-shrink-0"
                          title="<%= t('common.delete') %>">
                    <i class="bi bi-x-lg"></i>
                  </button>
                </div>
              </div>

              <div class="tuning-strip mt-2.5 pt-2.5 border-top <%= 'd-none' unless is_text || is_num || is_sel %>">
                <div class="tuning-text-group row g-2 <%= 'd-none' unless is_text %>">
                  <div class="col-6 col-md-3">
                    <label class="form-label text-secondary mb-1" style="font-size: 0.72rem;"><%= t('inventory.min_length') %></label>
                    <input type="number" min="0" max="10000" name="custom_fields[<%= idx %>][min_length]" value="<%= field.min_length %>" class="form-control form-control-sm font-mono" placeholder="0">
                  </div>
                  <div class="col-6 col-md-3">
                    <label class="form-label text-secondary mb-1" style="font-size: 0.72rem;"><%= t('inventory.max_length') %></label>
                    <input type="number" min="1" max="10000" name="custom_fields[<%= idx %>][max_length]" value="<%= field.max_length %>" class="form-control form-control-sm font-mono" placeholder="255">
                  </div>
                  <div class="col-12 col-md-6">
                    <label class="form-label text-secondary mb-1" style="font-size: 0.72rem;"><%= t('inventory.regex_pattern') %></label>
                    <input type="text" name="custom_fields[<%= idx %>][regex_pattern]" value="<%= field.regex_pattern %>" class="form-control form-control-sm font-mono" placeholder="^[A-Z0-9-]+$">
                  </div>
                </div>

                <div class="tuning-numeric-group row g-2 <%= 'd-none' unless is_num %>">
                  <div class="col-6 col-md-4">
                    <label class="form-label text-secondary mb-1" style="font-size: 0.72rem;"><%= t('inventory.min_value') %></label>
                    <input type="number" step="any" name="custom_fields[<%= idx %>][min_value]" value="<%= field.min_value.present? ? format_numeric_value(field.min_value) : '' %>" class="form-control form-control-sm font-mono" placeholder="0">
                  </div>
                  <div class="col-6 col-md-4">
                    <label class="form-label text-secondary mb-1" style="font-size: 0.72rem;"><%= t('inventory.max_value') %></label>
                    <input type="number" step="any" name="custom_fields[<%= idx %>][max_value]" value="<%= field.max_value.present? ? format_numeric_value(field.max_value) : '' %>" class="form-control form-control-sm font-mono" placeholder="10000">
                  </div>
                </div>

                <div class="tuning-select-group <%= 'd-none' unless is_sel %>">
                  <label class="form-label text-secondary mb-1" style="font-size: 0.72rem;"><%= t('inventory.select_options_label') %></label>
                  <input type="text"
                         name="custom_fields[<%= idx %>][select_options]"
                         value="<%= field.parsed_select_options.join(', ') %>"
                         class="form-control form-control-sm field-select-options-input"
                         placeholder="Desktop, Laptop, Table">
                </div>
              </div>
            </div>
          <% end %>
        </div>

        <template id="dynamicFieldRowTemplate">
          <div class="dynamic-field-row p-3 rounded-3 bg-body border shadow-sm">
            <input type="hidden" name="custom_fields[__IDX__][id]" value="" class="field-id-input">
            <input type="hidden" name="custom_fields[__IDX__][position]" value="1" class="field-position-input">

            <div class="row g-2 align-items-center">
              <div class="col-12 col-lg-3 d-flex align-items-center gap-2">
                <span class="field-drag-handle text-secondary px-1 flex-shrink-0" style="cursor: grab;"><i class="bi bi-grip-vertical"></i></span>
                <select name="custom_fields[__IDX__][field_type]"
                        class="form-select form-select-sm field-type-select"
                        data-action="change->inventory-workspace#onDynamicFieldTypeChange">
                  <% CustomField::FIELD_TYPES.each do |type_key, fallback| %>
                    <option value="<%= type_key %>"><%= localized_field_type_label(type_key, fallback) %></option>
                  <% end %>
                </select>
              </div>
              <div class="col-12 col-md-5 col-lg-3">
                <input type="text"
                       name="custom_fields[__IDX__][name]"
                       value=""
                       class="form-control form-control-sm fw-semibold field-name-input"
                       placeholder="<%= t('inventory.field_title_placeholder') %>"
                       required>
              </div>
              <div class="col-12 col-md-7 col-lg-3">
                <input type="text"
                       name="custom_fields[__IDX__][description]"
                       value=""
                       class="form-control form-control-sm"
                       placeholder="<%= t('inventory.field_desc_placeholder') %>">
              </div>
              <div class="col-12 col-lg-3 d-flex align-items-center justify-content-between justify-content-lg-end gap-2">
                <div class="form-check m-0">
                  <input type="hidden" name="custom_fields[__IDX__][show_in_table]" value="0">
                  <input type="checkbox"
                         name="custom_fields[__IDX__][show_in_table]"
                         value="1"
                         class="form-check-input field-show-checkbox"
                         id="tbl_cf___IDX__"
                         checked>
                  <label class="form-check-label small text-nowrap field-show-label" for="tbl_cf___IDX__"><%= t('inventory.show_in_table') %></label>
                </div>
                <button type="button"
                        data-action="click->inventory-workspace#removeDynamicField"
                        class="btn btn-sm btn-outline-danger rounded-3 flex-shrink-0"
                        title="<%= t('common.delete') %>">
                  <i class="bi bi-x-lg"></i>
                </button>
              </div>
            </div>

            <div class="tuning-strip mt-2.5 pt-2.5 border-top d-none">
              <div class="tuning-text-group row g-2 d-none">
                <div class="col-6 col-md-3">
                  <label class="form-label text-secondary mb-1" style="font-size: 0.72rem;"><%= t('inventory.min_length') %></label>
                  <input type="number" min="0" max="10000" name="custom_fields[__IDX__][min_length]" value="" class="form-control form-control-sm font-mono" placeholder="0">
                </div>
                <div class="col-6 col-md-3">
                  <label class="form-label text-secondary mb-1" style="font-size: 0.72rem;"><%= t('inventory.max_length') %></label>
                  <input type="number" min="1" max="10000" name="custom_fields[__IDX__][max_length]" value="" class="form-control form-control-sm font-mono" placeholder="255">
                </div>
                <div class="col-12 col-md-6">
                  <label class="form-label text-secondary mb-1" style="font-size: 0.72rem;"><%= t('inventory.regex_pattern') %></label>
                  <input type="text" name="custom_fields[__IDX__][regex_pattern]" value="" class="form-control form-control-sm font-mono" placeholder="^[A-Z0-9-]+$">
                </div>
              </div>

              <div class="tuning-numeric-group row g-2 d-none">
                <div class="col-6 col-md-4">
                  <label class="form-label text-secondary mb-1" style="font-size: 0.72rem;"><%= t('inventory.min_value') %></label>
                  <input type="number" step="any" name="custom_fields[__IDX__][min_value]" value="" class="form-control form-control-sm font-mono" placeholder="0">
                </div>
                <div class="col-6 col-md-4">
                  <label class="form-label text-secondary mb-1" style="font-size: 0.72rem;"><%= t('inventory.max_value') %></label>
                  <input type="number" step="any" name="custom_fields[__IDX__][max_value]" value="" class="form-control form-control-sm font-mono" placeholder="10000">
                </div>
              </div>

              <div class="tuning-select-group d-none">
                <label class="form-label text-secondary mb-1" style="font-size: 0.72rem;"><%= t('inventory.select_options_label') %></label>
                <input type="text"
                       name="custom_fields[__IDX__][select_options]"
                       value=""
                       class="form-control form-control-sm field-select-options-input"
                       placeholder="Desktop, Laptop, Table">
              </div>
            </div>
          </div>
        </template>

        <div class="d-flex justify-content-end pt-3 border-top">
          <button type="submit" class="btn btn-primary btn-sm fw-semibold rounded-3 px-4 py-2 shadow-sm"><%= t('common.save') %></button>
        </div>
      <% end %>
    </div>

  <% elsif @active_tab == "access" && can_manage %>
    <div class="card p-4 mb-4">
      <%= form_with model: @inventory, url: inventory_path(@inventory, tab: "access"), method: :patch, data: { inventory_workspace_target: "autoSaveForm" } do |f| %>
        <%= f.hidden_field :lock_version, data: { inventory_workspace_target: "lockVersion" } %>
        <input type="hidden" name="force_overwrite" value="0" data-inventory-workspace-target="forceOverwriteInput">

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
          <div>
            <div class="d-flex align-items-center gap-2 mb-1">
              <h2 class="h6 fw-bold mb-0"><i class="bi bi-shield-check text-primary me-1"></i><%= t('inventory.tabs.access') %></h2>
              <span data-inventory-workspace-target="accessStatusBadge" class="badge rounded-pill px-3 py-1 <%= @inventory.is_public? ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-secondary-subtle text-secondary border border-secondary-subtle' %>">
                <i class="bi <%= @inventory.is_public? ? 'bi-globe2' : 'bi-lock-fill' %> me-1"></i><%= @inventory.is_public? ? t('common.public') : t('common.restricted') %>
              </span>
            </div>
            <p class="text-secondary small mb-0"><%= t('inventory.public_access') %></p>
          </div>
          <div class="form-check form-switch m-0">
            <%= f.check_box :is_public,
                  class: "form-check-input fs-4",
                  id: "accessTabPublicSwitch",
                  data: { action: "change->inventory-workspace#saveImmediately" } %>
          </div>
        </div>
      <% end %>

      <div data-inventory-workspace-target="publicAccessNotice" class="alert alert-info border-0 rounded-3 small py-2 px-3 mt-3 mb-0 d-flex align-items-center gap-2 <%= 'd-none' unless @inventory.is_public? %>">
        <i class="bi bi-info-circle-fill flex-shrink-0"></i>
        <span><%= t('inventory.public_access_notice', default: 'Public mode is active — all signed-in users currently have write access. Users listed below will retain access if you switch back to Restricted.') %></span>
      </div>
    </div>

    <div class="card p-4 mb-4">
      <h2 class="h6 fw-bold mb-2"><%= t('inventory.grant_access_title') %></h2>
      <%= form_with url: grant_access_inventory_path(@inventory),
            method: :post,
            data: { action: "submit->inventory-workspace#flushBeforeFormSubmit" },
            class: "d-flex flex-wrap gap-2 align-items-start" do %>
        <div class="flex-grow-1" style="max-width: 420px;">
          <select name="user_identifier" data-inventory-workspace-target="userAccessSelect" placeholder="<%= t('inventory.grant_access_placeholder') %>" required></select>
        </div>
        <button type="submit" class="btn btn-primary btn-sm fw-semibold rounded-3 px-3 py-2 shadow-sm">
          <i class="bi bi-person-plus-fill me-1"></i><%= t('inventory.grant_access_btn') %>
        </button>
      <% end %>
    </div>

    <div class="card overflow-hidden" data-controller="table-selection">
      <%= form_with url: revoke_access_inventory_path(@inventory), method: :delete, data: { table_selection_target: "form" } do %>
        <div data-table-selection-target="idsContainer"></div>
      <% end %>
      <div data-table-selection-target="toolbar" class="context-toolbar d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="d-flex align-items-center gap-2">
          <span data-table-selection-target="counter" data-label="<%= t('home.toolbar_selected') %>" class="badge text-bg-secondary rounded-pill font-mono px-3 py-1">0 <%= t('home.toolbar_selected') %></span>
          <button type="button" data-table-selection-target="bulkAction" data-action="click->table-selection#submitBulk" class="btn btn-sm btn-outline-danger rounded-3" disabled>
            <i class="bi bi-person-dash me-1"></i><%= t('inventory.remove_selected') %>
          </button>
        </div>
        <div class="btn-group btn-group-sm">
          <%= link_to t('inventory.sort_by_name'), inventory_path(@inventory, tab: "access", access_sort: "name"), class: "btn #{params[:access_sort] != 'email' ? 'btn-primary' : 'btn-outline-secondary'}" %>
          <%= link_to t('inventory.sort_by_email'), inventory_path(@inventory, tab: "access", access_sort: "email"), class: "btn #{params[:access_sort] == 'email' ? 'btn-primary' : 'btn-outline-secondary'}" %>
        </div>
      </div>
      <div class="table-responsive">
        <table class="table table-hover table-enterprise align-middle mb-0">
          <thead>
            <tr>
              <th class="ps-4" style="width: 44px;"><input type="checkbox" class="form-check-input" data-table-selection-target="selectAll" data-action="change->table-selection#toggleAll"></th>
              <th><%= t('auth.full_name') %></th>
              <th class="pe-4"><%= t('auth.email') %></th>
            </tr>
          </thead>
          <tbody>
            <% if @access_records.empty? %>
              <tr>
                <td colspan="3" class="empty-state-box">
                  <div class="empty-state-icon"><i class="bi bi-people"></i></div>
                  <div class="text-secondary small"><%= t('inventory.no_users') %></div>
                </td>
              </tr>
            <% else %>
              <% @access_records.each do |record| %>
                <tr>
                  <td class="ps-4"><input type="checkbox" class="form-check-input" value="<%= record.id %>" data-table-selection-target="rowCheckbox" data-action="change->table-selection#toggleRow"></td>
                  <td>
                    <div class="d-flex align-items-center gap-2">
                      <span class="avatar-circle"><%= user_initials(record.user.name) %></span>
                      <%= link_to record.user.name, user_path(record.user), class: "fw-semibold text-body text-decoration-underline" %>
                    </div>
                  </td>
                  <td class="font-mono small text-secondary pe-4"><%= record.user.email %></td>
                </tr>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

  <% elsif @active_tab == "stats" && can_manage %>
    <% has_likes = @statistics[:total_likes].to_i.positive? %>
    <div class="row g-3">
      <div class="col-md-6">
        <div class="bento-stat-card bg-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <div class="text-secondary small fw-medium"><%= t('home.stats_items') %></div>
              <div class="fs-2 fw-bold font-mono text-primary"><%= @statistics[:total_items] %></div>
            </div>
            <span class="stat-icon-badge"><i class="bi bi-box-seam"></i></span>
          </div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="bento-stat-card bg-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <div class="text-secondary small fw-medium"><%= t('common.likes') %></div>
              <div class="fs-2 fw-bold font-mono <%= has_likes ? 'text-danger' : 'text-body' %>"><%= @statistics[:total_likes] %></div>
            </div>
            <span class="stat-icon-badge <%= has_likes ? 'text-danger' : 'text-secondary' %>" style="<%= has_likes ? 'background-color: rgba(239, 68, 68, 0.12);' : '' %>">
              <i class="bi <%= has_likes ? 'bi-heart-fill' : 'bi-heart' %>"></i>
            </span>
          </div>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="card p-4 h-100">
          <h3 class="h6 fw-bold mb-3"><i class="bi bi-calculator text-primary me-2"></i><%= t('inventory.stats_numeric_title') %></h3>
          <% if @statistics[:numeric].empty? %>
            <p class="text-secondary small mb-0"><%= t('inventory.no_numeric') %></p>
          <% else %>
            <div class="table-responsive">
              <table class="table table-sm font-mono small mb-0">
                <thead><tr><th><%= t('inventory.field_col') %></th><th><%= t('inventory.stats_avg') %></th><th><%= t('inventory.stats_min') %></th><th><%= t('inventory.stats_max') %></th></tr></thead>
                <tbody>
                  <% @statistics[:numeric].each do |stat| %>
                    <tr>
                      <td class="fw-semibold"><%= stat[:name] %></td>
                      <td class="text-primary fw-bold"><%= format_numeric_value(stat[:avg]) %></td>
                      <td><%= format_numeric_value(stat[:min]) %></td>
                      <td><%= format_numeric_value(stat[:max]) %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% end %>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="card p-4 h-100">
          <h3 class="h6 fw-bold mb-3"><i class="bi bi-bar-chart-steps text-primary me-2"></i><%= t('inventory.stats_string_title') %></h3>
          <% if @statistics[:strings].empty? %>
            <p class="text-secondary small mb-0"><%= t('inventory.no_strings') %></p>
          <% else %>
            <% @statistics[:strings].each do |s| %>
              <div class="mb-3">
                <div class="fw-semibold small mb-1"><%= s[:name] %></div>
                <% if s[:top_values].empty? %>
                  <span class="text-secondary small">—</span>
                <% else %>
                  <div class="d-flex flex-wrap gap-2">
                    <% s[:top_values].each do |val, count| %>
                      <span class="badge bg-body-tertiary text-body border font-mono rounded-pill px-3 py-1"><%= truncate(val.to_s, length: 28) %> (<%= count %>)</span>
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

  <% elsif @active_tab == "export" && can_manage %>
    <div class="card p-4 p-lg-5">
      <div class="text-center mb-4">
        <div class="empty-state-icon mx-auto mb-3"><i class="bi bi-file-earmark-spreadsheet"></i></div>
        <h2 class="h5 fw-bold mb-1"><%= t('inventory.export_title') %></h2>
        <p class="text-secondary small mb-0">
          <%= @inventory.title %> &bull;
          <span class="font-mono"><%= @inventory.items_count %> <%= t('home.col_items') %></span> &bull;
          <span class="font-mono"><%= @custom_fields.size %> <%= t('inventory.tabs.fields') %></span>
        </p>
      </div>

      <div class="row g-3 justify-content-center">
        <div class="col-md-5">
          <div class="bento-stat-card h-100 d-flex flex-column justify-content-between bg-body p-4">
            <div class="mb-4">
              <div class="d-flex align-items-center gap-2 mb-2">
                <i class="bi bi-filetype-csv fs-4 text-primary"></i>
                <h3 class="h6 fw-bold mb-0"><%= t('inventory.export_csv_title', default: 'CSV Spreadsheet (UTF-8)') %></h3>
              </div>
              <p class="text-secondary small mb-0"><%= t('inventory.export_csv_hint') %></p>
            </div>
            <%= link_to export_items_csv_inventory_path(@inventory),
                  data: { turbo: false },
                  class: "btn btn-outline-primary fw-semibold rounded-3 w-100 py-2" do %>
              <i class="bi bi-download me-1.5"></i><%= t('inventory.export_csv_btn') %>
            <% end %>
          </div>
        </div>

        <div class="col-md-5">
          <div class="bento-stat-card h-100 d-flex flex-column justify-content-between bg-body p-4">
            <div class="mb-4">
              <div class="d-flex align-items-center gap-2 mb-2">
                <i class="bi bi-file-earmark-excel-fill fs-4 text-success"></i>
                <h3 class="h6 fw-bold mb-0"><%= t('inventory.export_xlsx_title', default: 'Microsoft Excel (.xlsx)') %></h3>
              </div>
              <p class="text-secondary small mb-0"><%= t('inventory.export_xlsx_hint') %></p>
            </div>
            <%= link_to export_items_xlsx_inventory_path(@inventory),
                  data: { turbo: false },
                  class: "btn btn-primary fw-semibold rounded-3 w-100 py-2 shadow-sm" do %>
              <i class="bi bi-file-earmark-arrow-down me-1.5"></i><%= t('inventory.export_xlsx_btn') %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>