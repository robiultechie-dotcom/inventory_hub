<%
  can_write = @inventory.writable_by?(current_user)
  liked = current_user && @item.likes.exists?(user_id: current_user.id)
  short_fields_count = @custom_fields.count { |f| !%w[text link].include?(f.field_type) }
  short_col_class = case short_fields_count
                    when 1 then "col-12"
                    when 2, 4 then "col-md-6"
                    else "col-md-6 col-lg-4"
                    end
  pdf_modals = []
%>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb mb-0 small">
      <li class="breadcrumb-item"><%= link_to t('home.stats_inventories'), root_path, class: "text-decoration-none" %></li>
      <li class="breadcrumb-item"><%= link_to @inventory.title, inventory_path(@inventory, tab: "items"), class: "text-decoration-none" %></li>
      <li class="breadcrumb-item active font-mono fw-semibold" aria-current="page"><%= @item.custom_id %></li>
    </ol>
  </nav>

  <div class="d-flex align-items-center gap-2">
    <%= link_to inventory_path(@inventory, tab: "items"), class: "btn btn-sm btn-outline-secondary rounded-3 px-3" do %>
      <i class="bi bi-arrow-left me-1"></i><%= t('common.back') %>
    <% end %>
    <% if can_write %>
      <%= link_to edit_inventory_item_path(@inventory, @item), class: "btn btn-sm btn-primary fw-semibold rounded-3 px-3 shadow-sm" do %>
        <i class="bi bi-pencil-square me-1"></i><%= t('common.edit') %>
      <% end %>
    <% end %>
  </div>
</div>

<div class="card hero-bento-card mb-4">
  <div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
      <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-mono px-2.5 py-1.5 fs-6">
          <%= @item.custom_id %>
        </span>
        <span class="badge bg-body-tertiary text-secondary border font-mono px-2 py-1.5"
              data-bs-toggle="tooltip"
              title="<%= t('common.revision', version: @item.lock_version, default: "Revision #{@item.lock_version}") %>">
          <i class="bi bi-layers me-1"></i>v<%= @item.lock_version %>
        </span>
      </div>
      <h1 class="h4 fw-bold mb-1.5"><%= @item.primary_label %></h1>
      <div class="d-flex flex-wrap align-items-center gap-2 text-secondary small">
        <span class="avatar-circle" style="width: 22px; height: 22px; font-size: 0.65rem;"><%= user_initials(@item.created_by.name) %></span>
        <span><%= t('inventory.created_by') %> <%= link_to @item.created_by.name, user_path(@item.created_by), class: "fw-semibold text-body text-decoration-underline" %></span>
        <span class="opacity-50">&bull;</span>
        <span class="font-mono"><%= @item.created_at.strftime("%Y-%m-%d %H:%M") %> (<%= localized_time_ago(@item.created_at) %>)</span>
      </div>
    </div>

    <div>
      <% if current_user %>
        <%= button_to toggle_like_inventory_item_path(@inventory, @item),
              method: :post,
              class: "btn #{liked ? 'btn-danger shadow-sm' : 'btn-outline-danger'} rounded-pill px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2" do %>
          <i class="bi <%= liked ? 'bi-heart-fill' : 'bi-heart' %>"></i>
          <span><%= t('common.likes') %></span>
          <span class="badge bg-body text-body rounded-pill font-mono ms-1"><%= @item.likes_count %></span>
        <% end %>
      <% else %>
        <span class="d-inline-flex align-items-center gap-2 px-3.5 py-2 rounded-pill border bg-body-tertiary text-body small fw-semibold">
          <i class="bi <%= @item.likes_count.positive? ? 'bi-heart-fill text-danger' : 'bi-heart text-secondary' %>"></i>
          <span class="font-mono"><%= @item.likes_count %></span>
          <span class="text-secondary fw-normal"><%= t('common.likes') %></span>
        </span>
      <% end %>
    </div>
  </div>
</div>

<div class="card border shadow-sm rounded-4 p-4">
  <div class="row g-3">
    <% if @custom_fields.empty? %>
      <div class="col-12 empty-state-box py-4">
        <div class="text-secondary small"><%= t('common.no_items') %></div>
      </div>
    <% else %>
      <% @custom_fields.each do |field| %>
        <% val = @item.value_for(field) %>
        <div class="<%= field.field_type == 'text' || field.link? ? 'col-12' : short_col_class %>">
          <div class="p-3.5 rounded-3 border bg-body-tertiary h-100 d-flex flex-column justify-content-between">
            <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
              <span class="modern-label text-secondary mb-0"><%= field.name %></span>
              <% if field.description.present? %>
                <span class="text-secondary small" data-bs-toggle="tooltip" title="<%= field.description %>">
                  <i class="bi bi-info-circle"></i>
                </span>
              <% end %>
            </div>

            <% case field.field_type %>
            <% when "bool" %>
              <div>
                <% if val %>
                  <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1.5 fw-semibold d-inline-flex align-items-center gap-1.5">
                    <i class="bi bi-check-circle-fill"></i><%= t('common.true_yes') %>
                  </span>
                <% else %>
                  <span class="badge bg-body-secondary text-secondary border rounded-pill px-3 py-1.5 fw-semibold d-inline-flex align-items-center gap-1.5">
                    <i class="bi bi-dash-circle"></i><%= t('common.false_no') %>
                  </span>
                <% end %>
              </div>

            <% when "text" %>
              <div class="markdown-excerpt small text-body">
                <%= val.present? ? render_markdown(val.to_s) : "—" %>
              </div>

            <% when "select" %>
              <div>
                <% if val.present? %>
                  <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1.5 fw-semibold"><%= val %></span>
                <% else %>
                  <span class="text-secondary">—</span>
                <% end %>
              </div>

            <% when "link" %>
              <% if val.present? %>
                <%
                  url_str = val.to_s.strip
                  parsed_uri = begin
                    URI.parse(url_str)
                  rescue URI::InvalidURIError
                    nil
                  end
                  host_label = parsed_uri&.host.presence || url_str
                  raw_name = parsed_uri&.path.present? && parsed_uri.path != "/" ? File.basename(parsed_uri.path) : host_label
                  file_label = CGI.unescape(raw_name.to_s).presence || host_label
                  is_image = url_str.match?(/\.(jpg|jpeg|png|gif|webp)(\?.*)?\z/i) ||
                             url_str.include?("images.unsplash.com") ||
                             url_str.include?("res.cloudinary.com") ||
                             url_str.include?("iili.io")
                  is_pdf = url_str.match?(/\.pdf(\?.*)?\z/i)
                  icon_box_class = if is_pdf
                                     "bg-danger-subtle text-danger border-danger-subtle"
                                   elsif is_image
                                     "bg-info-subtle text-info border-info-subtle"
                                   else
                                     "bg-primary-subtle text-primary border-primary-subtle"
                                   end
                  icon_class = if is_pdf
                                 "bi-file-earmark-pdf-fill"
                               elsif is_image
                                 "bi-image-fill"
                               else
                                 "bi-link-45deg"
                               end
                  modal_id = "docPreviewModal-#{field.id}"
                  pdf_modals << { id: modal_id, title: file_label, url: url_str } if is_pdf
                %>
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 p-3 rounded-3 border bg-body">
                  <div class="d-flex align-items-center gap-3 overflow-hidden" style="min-width: 0;">
                    <span class="d-inline-flex align-items-center justify-content-center rounded-3 border flex-shrink-0 <%= icon_box_class %>" style="width: 42px; height: 42px;">
                      <i class="bi <%= icon_class %> fs-5"></i>
                    </span>
                    <div class="overflow-hidden">
                      <div class="fw-semibold text-body small text-truncate"><%= file_label %></div>
                      <div class="text-secondary font-mono text-truncate" style="font-size: 0.75rem;"><%= host_label %></div>
                    </div>
                  </div>
                  <div class="d-flex align-items-center gap-2 flex-shrink-0">
                    <% if is_pdf %>
                      <button type="button"
                              class="btn btn-sm btn-primary rounded-3 px-3 fw-semibold"
                              data-bs-toggle="modal"
                              data-bs-target="#<%= modal_id %>">
                        <i class="bi bi-eye me-1.5"></i><%= t('items.document_preview') %>
                      </button>
                    <% end %>
                    <%= link_to url_str, target: "_blank", rel: "noopener noreferrer", class: "btn btn-sm btn-outline-primary rounded-3 px-3 fw-semibold" do %>
                      <span><%= t('common.open') %></span>
                      <i class="bi bi-box-arrow-up-right ms-1.5"></i>
                    <% end %>
                  </div>
                </div>

                <% if is_image %>
                  <div class="mt-3 p-2 rounded-3 border bg-body text-center">
                    <%= link_to url_str, target: "_blank", rel: "noopener noreferrer" do %>
                      <img src="<%= url_str %>"
                           alt="<%= field.name %>"
                           class="rounded-2 object-fit-contain"
                           style="max-height: 280px; max-width: 100%;"
                           onerror="this.closest('div').classList.add('d-none');">
                    <% end %>
                  </div>
                <% end %>
              <% else %>
                <span class="text-secondary">—</span>
              <% end %>

            <% when "int" %>
              <div class="fw-bold fs-5 font-mono text-primary">
                <%= format_numeric_value(val) %>
              </div>

            <% else %>
              <div class="fw-semibold fs-6 text-body text-break">
                <%= val.presence || "—" %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>

<% pdf_modals.each do |modal| %>
  <div class="modal fade" id="<%= modal[:id] %>" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
      <div class="modal-content modal-modern overflow-hidden">
        <div class="modal-header border-bottom px-4 py-3">
          <div class="d-flex align-items-center gap-2 overflow-hidden">
            <i class="bi bi-file-earmark-pdf-fill text-danger fs-5 flex-shrink-0"></i>
            <h6 class="modal-title fw-bold mb-0 text-truncate"><%= modal[:title] %></h6>
          </div>
          <div class="d-flex align-items-center gap-2 ms-auto">
            <%= link_to modal[:url], target: "_blank", rel: "noopener noreferrer", class: "btn btn-sm btn-outline-primary rounded-3 px-3 fw-semibold" do %>
              <span><%= t('common.open') %></span>
              <i class="bi bi-box-arrow-up-right ms-1"></i>
            <% end %>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
        </div>
        <div class="modal-body p-0 bg-body-tertiary">
          <iframe src="https://docs.google.com/gview?embedded=true&url=<%= ERB::Util.url_encode(modal[:url]) %>"
                  title="<%= modal[:title] %>"
                  class="w-100 border-0 d-block"
                  style="height: 75vh;"
                  loading="lazy"></iframe>
        </div>
      </div>
    </div>
  </div>
<% end %>