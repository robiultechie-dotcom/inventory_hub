<%
  id_example = CustomIdGenerator.new(@inventory).generate(preview: true)
  short_fields_count = @custom_fields.count { |f| !%w[text link].include?(f.field_type) }
  short_col_class = case short_fields_count
                    when 1 then "col-12"
                    when 2, 4 then "col-md-6"
                    else "col-md-6 col-lg-4"
                    end
  submit_label = @item.new_record? ? t('inventory.add_item') : t('common.save')
%>

<div class="card border shadow-sm rounded-4 p-4">
  <%= form_with model: [ @inventory, @item ], local: true do |f| %>
    <%= f.hidden_field :lock_version %>

    <% if @conflict_detected %>
      <div class="alert alert-danger border-0 shadow-sm rounded-3 d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div class="d-flex align-items-center">
          <i class="bi bi-exclamation-octagon-fill fs-5 me-2"></i>
          <strong><%= t('inventory.conflict_msg') %></strong>
        </div>
        <div class="d-flex gap-2">
          <%= link_to edit_inventory_item_path(@inventory, @item), class: "btn btn-sm btn-outline-danger bg-body fw-semibold rounded-3" do %>
            <i class="bi bi-arrow-clockwise me-1"></i><%= t('inventory.reload_latest') %>
          <% end %>
          <button type="submit" name="force_overwrite" value="1" class="btn btn-sm btn-danger fw-semibold rounded-3">
            <i class="bi bi-cloud-upload me-1"></i><%= t('inventory.overwrite_retry') %>
          </button>
        </div>
      </div>
    <% end %>

    <% if @item.errors.any? %>
      <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4">
        <div class="fw-bold small mb-1">
          <i class="bi bi-exclamation-triangle-fill me-1"></i><%= t('items.validation_failed') %>
        </div>
        <ul class="mb-0 small ps-3">
          <% @item.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="row g-3 pb-3 mb-4 border rounded-3 p-3 mx-0 bg-body-tertiary">
      <div class="col-md-6">
        <%= f.label :custom_id, t('items.custom_id_label', default: 'Custom ID'), class: "form-label modern-label" %>
        <div class="input-group">
          <span class="input-group-text bg-body font-mono text-primary"><i class="bi bi-upc-scan"></i></span>
          <%= f.text_field :custom_id,
                class: "form-control modern-input font-mono fw-semibold bg-body",
                required: true,
                placeholder: id_example %>
        </div>
        <div class="form-text small font-mono mt-1">
          <%= t('inventory.custom_id_example') %> <strong class="text-primary"><%= id_example %></strong>
        </div>
      </div>

      <div class="col-md-3">
        <label class="form-label modern-label text-secondary">
          <i class="bi bi-lock-fill me-1 opacity-75"></i><%= t('home.col_creator') %>
        </label>
        <input type="text"
               class="form-control modern-input bg-body-secondary text-secondary"
               value="<%= (@item.created_by || current_user)&.name %>"
               readonly
               disabled>
      </div>

      <div class="col-md-3">
        <label class="form-label modern-label text-secondary">
          <i class="bi bi-lock-fill me-1 opacity-75"></i><%= t('common.created_at') %>
        </label>
        <input type="text"
               class="form-control modern-input font-mono bg-body-secondary text-secondary"
               value="<%= (@item.created_at || Time.current).utc.strftime('%Y-%m-%d %H:%M UTC') %>"
               readonly
               disabled>
      </div>
    </div>

    <div class="row g-3">
      <% @custom_fields.each do |field| %>
        <% val = @item.value_for(field) %>
        <% input_id = "item_field_#{field.id}" %>
        <% input_name = "field_values[#{field.id}]" %>
        <div class="<%= field.field_type == 'text' || field.link? ? 'col-12' : short_col_class %>">
          <label for="<%= input_id %>" class="form-label modern-label mb-1"><%= field.name %></label>

          <% case field.field_type %>
          <% when "string" %>
            <input type="text"
                   id="<%= input_id %>"
                   name="<%= input_name %>"
                   value="<%= val %>"
                   class="form-control modern-input"
                   <%= "minlength=\"#{field.min_length}\"" if field.min_length.present? %>
                   maxlength="<%= [ field.max_length || 255, 255 ].min %>">

          <% when "text" %>
            <textarea id="<%= input_id %>"
                      name="<%= input_name %>"
                      rows="3"
                      class="form-control modern-input"
                      <%= "minlength=\"#{field.min_length}\"" if field.min_length.present? %>
                      maxlength="<%= [ field.max_length || 10_000, 10_000 ].min %>"><%= val %></textarea>

          <% when "int" %>
            <input type="number"
                   step="any"
                   id="<%= input_id %>"
                   name="<%= input_name %>"
                   value="<%= val.present? ? format_numeric_value(val) : '' %>"
                   class="form-control modern-input font-mono"
                   <%= "min=\"#{format_numeric_value(field.min_value)}\"" if field.min_value.present? %>
                   <%= "max=\"#{format_numeric_value(field.max_value)}\"" if field.max_value.present? %>>

          <% when "link" %>
            <input type="url"
                   id="<%= input_id %>"
                   name="<%= input_name %>"
                   value="<%= val %>"
                   class="form-control modern-input font-mono"
                   placeholder="https://...">

            <% if val.present? %>
              <%
                url_str = val.to_s.strip
                parsed_uri = begin
                  URI.parse(url_str)
                rescue URI::InvalidURIError
                  nil
                end
                host_label = parsed_uri&.host.presence || url_str
                raw_name = parsed_uri&.path.present? && parsed_uri.path != "/" ? File.basename(parsed_uri.path) : host_label
                file_label = CGI.unescape(raw_name.to_s).presence || host_label
                is_image = url_str.match?(/\.(jpg|jpeg|png|gif|webp)(\?.*)?\z/i) ||
                           url_str.include?("images.unsplash.com") ||
                           url_str.include?("res.cloudinary.com") ||
                           url_str.include?("iili.io")
                is_pdf = url_str.match?(/\.pdf(\?.*)?\z/i)
                icon_class = if is_pdf
                               "bi-file-earmark-pdf-fill text-danger"
                             elsif is_image
                               "bi-image-fill text-info"
                             else
                               "bi-link-45deg text-primary"
                             end
              %>
              <div class="mt-2 p-2.5 rounded-3 border bg-body-tertiary">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                  <div class="d-flex align-items-center gap-2 overflow-hidden" style="min-width: 0;">
                    <i class="bi <%= icon_class %> fs-5 flex-shrink-0"></i>
                    <div class="overflow-hidden">
                      <div class="fw-semibold text-body small text-truncate"><%= file_label %></div>
                      <div class="text-secondary font-mono text-truncate" style="font-size: 0.72rem;"><%= host_label %></div>
                    </div>
                  </div>
                  <%= link_to url_str, target: "_blank", rel: "noopener noreferrer", class: "btn btn-sm btn-outline-primary rounded-3 px-2.5 fw-semibold flex-shrink-0" do %>
                    <span><%= t('common.open') %></span>
                    <i class="bi bi-box-arrow-up-right ms-1"></i>
                  <% end %>
                </div>
                <% if is_image %>
                  <div class="mt-2 pt-2 border-top text-center">
                    <img src="<%= url_str %>"
                         alt="<%= field.name %>"
                         class="rounded-2 object-fit-contain"
                         style="max-height: 180px; max-width: 100%;"
                         onerror="this.closest('div').classList.add('d-none');">
                  </div>
                <% end %>
              </div>
            <% end %>

          <% when "bool" %>
            <div class="form-check form-switch pt-1">
              <input type="hidden" name="<%= input_name %>" value="0">
              <input type="checkbox"
                     id="<%= input_id %>"
                     name="<%= input_name %>"
                     value="1"
                     class="form-check-input fs-5"
                     <%= "checked" if val %>>
              <label for="<%= input_id %>" class="form-check-label small ms-1"><%= t('common.true_yes') %></label>
            </div>

          <% when "select" %>
            <% opts = field.parsed_select_options %>
            <% opts = [ val.to_s ] + opts if val.present? && !opts.include?(val.to_s) %>
            <select id="<%= input_id %>" name="<%= input_name %>" class="form-select modern-input">
              <option value="">—</option>
              <% opts.each do |opt| %>
                <option value="<%= opt %>" <%= "selected" if val.to_s == opt %>><%= opt %></option>
              <% end %>
            </select>
          <% end %>

          <% if field.description.present? || field.tuning_hints.any? %>
            <div class="form-text small d-flex flex-wrap align-items-center gap-2 mt-1">
              <% if field.description.present? %>
                <span><%= field.description %></span>
              <% end %>
              <% field.tuning_hints.each do |hint| %>
                <span class="badge bg-body-tertiary text-secondary border font-mono fw-normal"><%= hint %></span>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
      <%= link_to t('common.cancel'), inventory_path(@inventory, tab: "items"), class: "btn btn-outline-secondary rounded-3 px-4" %>
      <%= f.submit submit_label, class: "btn btn-primary fw-semibold rounded-3 px-4 shadow-sm" %>
    </div>
  <% end %>
</div>