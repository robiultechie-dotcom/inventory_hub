<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <div>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-1 small">
        <li class="breadcrumb-item"><%= link_to @inventory.title, inventory_path(@inventory, tab: "items"), class: "text-decoration-none" %></li>
        <li class="breadcrumb-item font-mono"><%= link_to @item.custom_id, inventory_item_path(@inventory, @item), class: "text-decoration-none" %></li>
        <li class="breadcrumb-item active" aria-current="page"><%= t('common.edit') %></li>
      </ol>
    </nav>
    <div class="d-flex align-items-center gap-2">
      <h1 class="h4 fw-bold mb-0"><%= t('common.edit') %></h1>
      <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-mono"><%= @item.custom_id %></span>
    </div>
  </div>

  <div class="d-flex gap-2">
    <%= link_to inventory_item_path(@inventory, @item), class: "btn btn-sm btn-outline-primary rounded-3" do %>
      <i class="bi bi-eye me-1"></i><%= t('common.open') %>
    <% end %>
    <%= link_to inventory_path(@inventory, tab: "items"), class: "btn btn-sm btn-outline-secondary rounded-3" do %>
      <i class="bi bi-arrow-left me-1"></i><%= t('common.back') %>
    <% end %>
  </div>
</div>

<%= render "form" %>